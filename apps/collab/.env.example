# Local development values for the Supabase CLI stack (`pnpm db:start`).
# Copy to apps/collab/.env.local. The keys below are the CLI's public demo keys.
PORT=1234
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=paste-the-secret-key-from-supabase-status
# shared with the capture Edge Function; any 16+ character string locally
INTERNAL_SECRET=local-dev-internal-secret
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100
