{
  "name": "scraps",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n web,collab,db -c magenta,cyan,green \"pnpm --filter @scraps/web dev\" \"pnpm --filter @scraps/collab dev\" \"pnpm db:start\"",
    "build": "pnpm -r build",
    "check": "pnpm -r typecheck && pnpm lint && pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "e2e": "pnpm --filter @scraps/web e2e",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/db/src/types.ts",
    "db:test": "supabase test db",
    "test:int": "pnpm --filter @scraps/collab test:int"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "supabase": "^2.120.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
