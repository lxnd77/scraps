# Copy to supabase/functions/.env (git ignored); `pnpm functions` loads it.
# Must equal INTERNAL_SECRET in apps/collab/.env.local.
INTERNAL_SECRET=local-dev-internal-secret
# The Edge runtime runs in Docker, so the collab server on the host is reached through this name.
COLLAB_INTERNAL_URL=http://host.docker.internal:1234
APP_URL=http://localhost:3000
# Phase 8. AI suggestions are off for every user until they opt in (profiles.ai_enabled).
ANTHROPIC_API_KEY=
# groq (default), openai, or fake (returns canned text; used by the e2e tests and for local work)
TRANSCRIPTION_PROVIDER=fake
TRANSCRIPTION_API_KEY=
# Phase 9.8. Leave empty to turn error reporting off.
SENTRY_DSN=
