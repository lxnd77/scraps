# Copy to supabase/functions/.env (git ignored); `pnpm functions` loads it.
# Must equal INTERNAL_SECRET in apps/collab/.env.local.
INTERNAL_SECRET=local-dev-internal-secret
# The Edge runtime runs in Docker, so the collab server on the host is reached through this name.
COLLAB_INTERNAL_URL=http://host.docker.internal:1234
APP_URL=http://localhost:3000
